# ─────────────────────────────────────────────────────────────
# Quittio — variables d'environnement
# Copiez ce fichier en `.env.local` (développement) et renseignez
# les mêmes variables dans Vercel → Settings → Environment Variables.
# Ne committez JAMAIS de vraies clés.
# ─────────────────────────────────────────────────────────────

# URL publique du site, sans slash final (canonical, sitemap, e-mails, redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse affichée sur le site pour le support
NEXT_PUBLIC_SUPPORT_EMAIL=bonjour@quittio.fr

# ── Firebase (client) — Console Firebase → Paramètres du projet → Vos applications → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (serveur) — Paramètres du projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com
# Collez la clé sur une seule ligne avec des \n littéraux, entre guillemets
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Stripe — Dashboard → Développeurs → Clés API (sk_test_… en test, sk_live_… en production)
STRIPE_SECRET_KEY=sk_test_
# Secret de signature du endpoint webhook (whsec_…). En local : fourni par `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_
# Identifiants des 6 prix récurrents (price_…) créés dans Stripe (voir README, section Stripe)
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_
STRIPE_PRICE_ESSENTIEL_YEARLY=price_
STRIPE_PRICE_SERENITE_MONTHLY=price_
STRIPE_PRICE_SERENITE_YEARLY=price_
STRIPE_PRICE_PATRIMOINE_MONTHLY=price_
STRIPE_PRICE_PATRIMOINE_YEARLY=price_

# ── Resend — https://resend.com/api-keys (sans clé, les e-mails sont simplement journalisés)
RESEND_API_KEY=re_
# Expéditeur sur un domaine vérifié dans Resend
EMAIL_FROM="Quittio <notifications@quittio.fr>"
# Boîte qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=bonjour@quittio.fr

# ── Cron Vercel — chaîne aléatoire longue (ex. `openssl rand -hex 32`).
# Vercel l'envoie automatiquement en « Authorization: Bearer … » aux routes cron.
CRON_SECRET=
