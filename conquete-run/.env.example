# ─────────────────────────────────────────────────────────────────────────────
# Conquête Run — variables d'environnement (copier en .env / .env.local, NE JAMAIS versionner)
# ─────────────────────────────────────────────────────────────────────────────

# ── App mobile (apps/mobile/.env.local, ou variables d'environnement EAS) ─────
# Préfixe EXPO_PUBLIC_ : valeurs PUBLIQUES embarquées dans l'app (jamais de secret ici).
# URL du projet Supabase : Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clé publique : Project Settings → API Keys → « publishable » (sb_publishable_…) ou « anon »
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Fond de carte MapLibre (facultatif ; défaut : OpenFreeMap Liberty, sans clé)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ── Edge Functions (supabase/functions/.env en local ; `supabase secrets set` en prod) ──
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournies automatiquement par Supabase
# aux Edge Functions déployées : ne les définir qu'en local.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=ne-jamais-mettre-dans-l-app
# Fournisseurs de modèle de terrain pour le D+, dans l'ordre d'essai
DEM_PROVIDERS=ign,opentopodata
# Instance Open Topo Data (auto-hébergée recommandée à grande échelle)
OPENTOPODATA_URL=https://api.opentopodata.org
OPENTOPODATA_DATASETS=eudem25m,srtm30m

# ── Auth (supabase/.env pour la CLI locale ; en prod : Dashboard → Authentication → Providers) ──
SUPABASE_AUTH_APPLE_CLIENT_ID=app.conqueterun.mobile
SUPABASE_AUTH_APPLE_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Scripts (saison de démo appliquée directement) ────────────────────────────
# Chaîne de connexion Postgres : Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
